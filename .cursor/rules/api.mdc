├── youtube/
├── webhooks/
└── cron/
```

### Authentication Quick Reference

```typescript
// Server Actions
import { auth } from "@/lib/auth";
const session = await auth();
if (!session?.user) throw new Error("Authentication required");

// API Routes
import { getUserIdForDb } from "@/lib/user-id";
const userId = await getUserIdForDb();
if (!userId) return NextResponse.json({ error: "Not authenticated" }, { status: 401 });

// Admin Routes
import { requireAdmin } from "@/lib/auth";
await requireAdmin(); // Throws if not admin
```

### Caching Quick Reference

| Data Type | Strategy | TTL |
|-----------|----------|-----|
| TMDB trending | L1 memory | 15 min |
| TMDB movie/series | L1+L2 | 1-2 hours |
| TMDB person | L1+L2 | 24 hours |
| MongoDB queries | `unstable_cache` | 1 hour |
| User data | No cache | - |

```typescript
// TMDB with in-memory cache
import { fetchFromTMDB } from "@/server/services/tmdb";
const data = await fetchFromTMDB("/movie/123", { cacheNamespace: "movie" });

// MongoDB with Next.js cache
import { getCachedMovieRatings } from "@/server/db/cached-queries";
const ratings = await getCachedMovieRatings(123);
```

### Zod Validation Pattern

```typescript
"use server";
import { z } from "zod";

const Schema = z.object({
  id: z.number().positive(),
  mediaType: z.enum(["movie", "tv"]),
});

export async function action(input: z.infer<typeof Schema>) {
  const validated = Schema.parse(input);
  // ... use validated data
}
```

### Error Response Format

```typescript
// Standard error
return NextResponse.json({ error: "Message" }, { status: 400 });

// With code
return NextResponse.json({ error: "Not found", code: "NOT_FOUND" }, { status: 404 });

// Success
return NextResponse.json({ success: true });
return NextResponse.json({ data: result });
```

### Parallel Fetching Pattern

```typescript
// Server Actions - parallel TMDB + MongoDB
const [tmdbData, dbData] = await Promise.all([
  getMovieDetails(id),
  getCachedMovieRatings(id),
]);

// API Routes - parallel MongoDB queries
const [watched, watchlist, ratings] = await Promise.all([
  WatchedMovie.find({ userId }).lean(),
  MoviesWatchlist.find({ userId }).lean(),
  UserRating.find({ userId }).lean(),
]);
```

### Database Connection

```typescript
import { connectDB } from "@/server/db";

// Always connect before queries
await connectDB();
const result = await Model.find({ ... }).lean();
```

### User ID for Nuxt Compatibility

```typescript
// userId is Google OAuth `sub` as Number (not string)
// This maintains compatibility with existing Nuxt app data
const userId = await getUserIdForDb(); // Returns number | null
```
