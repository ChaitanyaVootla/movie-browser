  const results = await SomeModel.find({ userId }).lean();
  // ...
}
```

## Parallel Queries

Use `Promise.all` for multiple independent queries:

```typescript
const [watchedMovies, watchlistMovies, watchlistSeries, ratings] =
  await Promise.all([
    WatchedMovie.find({ userId }).select("movieId -_id").lean(),
    MoviesWatchlist.find({ userId }).select("movieId -_id").lean(),
    SeriesWatchlist.find({ userId }).select("seriesId -_id").lean(),
    UserRating.find({ userId }).select("itemId itemType rating -_id").lean(),
  ]);
```

## Upsert Pattern

Use `findOneAndUpdate` with `upsert: true` for add operations:

```typescript
await MoviesWatchlist.findOneAndUpdate(
  { userId, movieId: movieIdNum },           // Find criteria
  { userId, movieId: movieIdNum, createdAt: new Date() },  // Update data
  { upsert: true }                           // Create if not exists
);
```

This prevents duplicate entries and simplifies add/update logic.
