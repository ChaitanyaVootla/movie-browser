  newAndUpcoming: Movie[];  // Future releases + last 60 days (sorted chronologically)
  collection: Movie[];      // Everything else (sorted by date added)
  allGenres: { id: number; name: string }[];  // Unique genres from user's movies
  totalCount: number;
}
