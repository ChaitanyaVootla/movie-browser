  return (
    <MediaLogoInner
      key={item.id} // Resets internal state when item changes
      {...props}
    />
  );
}

// ❌ BAD: useEffect to reset state (causes cascading renders)
useEffect(() => {
  setLoadState("cdn");
}, [item.id]);
```

