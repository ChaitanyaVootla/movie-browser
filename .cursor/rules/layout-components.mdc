<MediaCard item={movie} enableHover={false} />
```

## Search Command Component

### SearchCommand Usage

```tsx
import { SearchCommand, useSearchCommand } from "@/components/features/search";

// In layout or navbar
function NavBar() {
  const { open, setOpen } = useSearchCommand(); // Handles Cmd+K shortcut

  return (
    <>
      <Button onClick={() => setOpen(true)}>
        <Search /> Search
      </Button>
      <SearchCommand open={open} onOpenChange={setOpen} />
    </>
  );
}

// In MobileBottomNav - separate instance for mobile
function MobileBottomNav() {
  const { open, setOpen } = useSearchCommand();

  return (
    <>
      <button onClick={() => setOpen(true)}>Search</button>
      <SearchCommand open={open} onOpenChange={setOpen} />
    </>
  );
}
```

### Mobile Fullscreen Behavior

On mobile (< sm breakpoint), the search dialog expands to fullscreen:

```tsx
<DialogContent
  className={cn(
    "overflow-hidden p-0",
    // Mobile: full screen, no padding, top-aligned
    "max-sm:top-0 max-sm:left-0 max-sm:translate-x-0 max-sm:translate-y-0",
    "max-sm:max-w-none max-sm:w-full max-sm:h-full max-sm:rounded-none max-sm:border-0",
    // Desktop: centered, constrained width
    "sm:max-w-[600px]"
  )}
>
```

**Mobile-specific:**
- Fullscreen with no padding (keyboard takes bottom portion anyway)
- No rounded corners or border
- Keyboard shortcuts footer hidden (`hidden sm:flex`)

### Back Button Handling (Mobile)

The search dialog intercepts the mobile back button so pressing back closes the dialog instead of navigating away:

```tsx
// Handle mobile back button - push history state when open, close on popstate
const closedViaBack = React.useRef(false);

React.useEffect(() => {
  if (!open) return;

  const handlePopState = () => {
    closedViaBack.current = true;
    onOpenChange(false);
  };

  // Push a history state so back button closes dialog instead of navigating
  window.history.pushState({ searchOpen: true }, "");
  window.addEventListener("popstate", handlePopState);

  return () => {
    window.removeEventListener("popstate", handlePopState);
    // Clean up the history state if dialog closes normally (not via back)
    if (!closedViaBack.current && window.history.state?.searchOpen) {
      window.history.back();
    }
    closedViaBack.current = false;
  };
}, [open, onOpenChange]);
```

**Behavior:**
1. When dialog opens, pushes a history state `{ searchOpen: true }`
2. If user presses back button, `popstate` event fires → dialog closes
3. If dialog closes via other means (clicking result, X, Escape), the pushed history state is cleaned up
4. This prevents the back button from navigating away from the app

### Search Architecture

**Three-tier search with instant + deferred results:**

1. **Instant topics** (local, no API call) - Genres/themes match immediately as user types
2. **Recent visits** (from Zustand store) - Shown when search is empty
3. **API results** (debounced 250ms) - Movies, TV shows, people from TMDB

```
┌────────────────────────────────────────────────────────┐
│ Empty State                                            │
├────────────────────────────────────────────────────────┤
│ Recent (from user store)                               │
│ ├─ Breaking Bad               [TV icon]               │
│ ├─ Inception                  [Film icon]             │
│ └─ (up to 5 items)                                    │
├────────────────────────────────────────────────────────┤
│ Popular Topics (if < 3 recents)                        │
│ [Action Movies] [Comedy Movies] [Horror Movies] ...   │
│ (compact pills, up to 8)                              │
└────────────────────────────────────────────────────────┘

┌────────────────────────────────────────────────────────┐
│ Typing "action" State                                  │
├────────────────────────────────────────────────────────┤
│ [🔍 Search all for "action" →]                        │
├────────────────────────────────────────────────────────┤
│ Topics (instant, no API wait)                          │
│ [Action Movies] [Action Shows]                         │
├────────────────────────────────────────────────────────┤
│ Results (API - unified relevance order)               │
│ ├─ Action Movie Title    2019  ★7.5    [Film icon]   │
│ ├─ Action TV Show        2020  ★8.2    [TV icon]     │
│ └─ Action Star Actor     Acting        [User icon]   │
└────────────────────────────────────────────────────────┘
```

### Key Design Decisions

**1. Fixed minimum height** - Prevents layout shift when results load:
```tsx
const CONTENT_MIN_HEIGHT = "360px";
<CommandList style={{ minHeight: CONTENT_MIN_HEIGHT }}>
```

**2. Topics search instantly** - Uses `useMemo` (not debounced), from local `searchTopics()`:
```tsx
const matchingTopics = React.useMemo(() => {
  if (!query.trim() || query.length < 2) return [];
  return searchTopics(query, 4); // Local search, instant
}, [query]);
```

**3. Unified results order** - API results stay in TMDB's relevance order (no segregation by type):
```tsx
// Server action returns unified results
export async function quickSearch(query: string): Promise<QuickSearchResponse> {
  return {
    results: response.results.slice(0, 8), // Mixed movies/tv/people in relevance order
  };
}
```

**4. Compact topic pills** - Topics render as horizontal pills (not full command items):
```tsx
const renderTopicPills = (topics) => (
  <div className="flex flex-wrap gap-1.5 px-2 py-2">
    {topics.map((topic) => (
      <button
        onClick={() => handleSelectTopic(topic.key)}
        className="inline-flex items-center gap-1 rounded-full border bg-muted/50 px-2.5 py-1 text-xs"
      >
        {topic.name}
      </button>
    ))}
  </div>
);
```

