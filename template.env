# =============================================================================
# Movie Browser — Environment Configuration
# =============================================================================
# Copy this file to .env.local and fill in your values
# NEVER commit .env.local to version control

# =============================================================================
# Authentication (Auth.js v5)
# =============================================================================

# Generate with: openssl rand -base64 32
AUTH_SECRET=your-secret-key-here

# Google OAuth — https://console.cloud.google.com/apis/credentials
# Redirect URIs:
#   Dev:  http://localhost:3000/api/auth/callback/google
#   Prod: https://yourdomain.com/api/auth/callback/google
GOOGLE_AUTH_CLIENT_ID=your-google-client-id
GOOGLE_AUTH_CLIENT_SECRET=your-google-client-secret

# Public Google Client ID (for Google One Tap on the client — same as above)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id

# =============================================================================
# Admin
# =============================================================================

# Comma-separated admin email addresses
ADMIN_EMAILS=speedblaze@gmail.com

# =============================================================================
# Database — PostgreSQL (primary)
# =============================================================================

# Prisma connection URL
# Port 5433 maps to PG container's 5432 (avoids conflicts with host PG)
DATABASE_URL="postgresql://moviebrowser:localdev123@localhost:5433/moviebrowser?schema=public"

# Shadow database for Prisma migrations (created by postgres/init/01-extensions.sql)
SHADOW_DATABASE_URL="postgresql://moviebrowser:localdev123@localhost:5433/moviebrowser_shadow?schema=public"

# Docker Compose password (must match DATABASE_URL)
POSTGRES_PASSWORD=localdev123

# =============================================================================
# Database — MongoDB (temporary, remote — until GA migration complete)
# =============================================================================

# Remote MongoDB on existing EC2 (for user data + enrichment until GA switch)
# Set MONGO_IP to the old EC2's Elastic IP
MONGODB_URI=mongodb://root:your-mongo-password@OLD_EC2_IP:27018/moviebrowser?authSource=admin
MONGO_IP=OLD_EC2_IP
MONGO_PORT=27018
MONGO_PASS=your-mongo-password

# =============================================================================
# User Data Source
# =============================================================================

# Controls where user data (watchlist, ratings, etc.) is stored
# "mongodb" (default) — reads/writes MongoDB on remote EC2
# "postgres" — reads/writes PostgreSQL (set this at GA after migration)
USER_DATA_SOURCE=mongodb

# =============================================================================
# External APIs
# =============================================================================

# TMDB API — https://www.themoviedb.org/settings/api
TMDB_API_KEY=your-tmdb-api-key

# YouTube Data API v3 — https://console.cloud.google.com/apis/credentials
YOUTUBE_API_KEY=your-youtube-api-key

# =============================================================================
# CDN & URLs
# =============================================================================

# CDN for optimized images (optional — falls back to TMDB images)
CDN_API_URL=https://api.themoviebrowser.com

# Public site URL (OAuth callbacks, canonical URLs)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# =============================================================================
# Tavily Web Search (AI Agent)
# =============================================================================

# Tavily API for web search and content extraction in the AI agent.
# Free tier: 1,000 credits/month. Get key at https://app.tavily.com
# Basic search = 1 credit, advanced = 2 credits, extract = 1 per 5 URLs.
TAVILY_API_KEY=your-tavily-api-key

# =============================================================================
# AI Provider
# =============================================================================

# "bedrock" (default for GA) or "openrouter" (fallback)
AI_PROVIDER=bedrock

# =============================================================================
# AWS Credentials
# =============================================================================

# On EC2: OMIT these — the instance profile provides Bedrock access automatically.
# Locally: Set these for development.
# AWS_ACCESS_KEY_ID=your-aws-access-key
# AWS_SECRET_ACCESS_KEY=your-aws-secret-key

# =============================================================================
# AI Agent — AWS Bedrock (Kimi K2.5)
# =============================================================================

# Region: ap-south-1 (Mumbai) — closest to Hyderabad EC2, supports Kimi K2.5
# Model: moonshotai.kimi-k2.5 — Moonshot AI's multimodal model
# Enable model access: https://ap-south-1.console.aws.amazon.com/bedrock/home?region=ap-south-1#/modelaccess
BEDROCK_REGION=ap-south-1
BEDROCK_MODEL_ID=moonshotai.kimi-k2.5

# =============================================================================
# Embeddings — AWS Bedrock (Cohere Embed v4)
# =============================================================================

# Model: global.cohere.embed-v4:0 (cross-region inference from ap-south-1)
# Dimensions: 1024, stored in PostgreSQL vector(1024) column
# Enable model access in Bedrock console for Cohere models
COHERE_EMBED_MODEL_ID=global.cohere.embed-v4:0

# =============================================================================
# OpenRouter (fallback AI provider)
# =============================================================================

# Only needed if AI_PROVIDER=openrouter
# OPENROUTER_KEY=your-openrouter-key
# OPENROUTER_MODEL_ID=moonshotai/kimi-k2.5

# =============================================================================
# ClickHouse — Analytics
# =============================================================================

# ClickHouse runs in Docker via docker-compose.yml
# On EC2: localhost. Locally: localhost (if running docker-compose).
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_DATABASE=analytics
CLICKHOUSE_USER=analytics
CLICKHOUSE_PASSWORD=analytics_secret_123
CLICKHOUSE_PROTOCOL=http

# =============================================================================
# Data Hydration Service
# =============================================================================

# PostgreSQL is source of truth. Hydration flow:
#   Check PG → TMDB API if stale → MongoDB enrichment → Upsert to PG → Return
USE_HYDRATION_SERVICE=true

# MongoDB enrichment (ratings, watch links from remote MongoDB)
# Set to false to skip MongoDB and use Lambda only
ENABLE_MONGODB_ENRICHMENT=true

# Lambda fallback when MongoDB data is stale
ENABLE_LAMBDA_FALLBACK=true

# =============================================================================
# Testing
# =============================================================================

# Test User ID — numeric Google OAuth sub for testing AI agent user context
# Run: yarn test:ai --user
TEST_USER_ID=
