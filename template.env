# =============================================================================
# Movie Browser - Environment Configuration
# =============================================================================
# Copy this file to .env.local and fill in your values
# NEVER commit .env.local to version control

# =============================================================================
# Authentication (Auth.js v5)
# =============================================================================

# AUTH_SECRET - Required for production, optional in development
# Generate with: openssl rand -base64 32
# Or use: npx auth secret
AUTH_SECRET=your-secret-key-here-generate-with-openssl-rand-base64-32

# Google OAuth - Get from https://console.cloud.google.com/apis/credentials
# 1. Create a new OAuth 2.0 Client ID
# 2. Set authorized redirect URIs:
#    - http://localhost:3000/api/auth/callback/google (development)
#    - https://yourdomain.com/api/auth/callback/google (production)
# 3. Enable Google Identity Services API for One Tap support
GOOGLE_AUTH_CLIENT_ID=your-google-client-id
GOOGLE_AUTH_CLIENT_SECRET=your-google-client-secret

# Public Google Client ID (for Google One Tap on the client)
# This is the same as GOOGLE_AUTH_CLIENT_ID but exposed to the browser
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id

# =============================================================================
# Admin Configuration
# =============================================================================

# Comma-separated list of admin email addresses
# Users with these emails get admin access (role: "admin" in session)
ADMIN_EMAILS=speedblaze@gmail.com

# =============================================================================
# Database (MongoDB - legacy, being replaced by PostgreSQL)
# =============================================================================

# Option 1: Full MongoDB URI (if using Atlas or standard connection)
MONGODB_URI=mongodb://localhost:27017/moviebrowser

# Option 2: Individual MongoDB config (used by auth adapter)
# Use this if connecting to a password-protected local MongoDB
MONGO_IP=localhost
MONGO_PORT=27017
MONGO_PASS=your-mongo-password

# =============================================================================
# Database (PostgreSQL - primary database)
# =============================================================================

# Main connection URL for Prisma
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
# Note: Using port 5433 to avoid conflict with existing PostgreSQL on 5432
DATABASE_URL="postgresql://moviebrowser:localdev123@localhost:5433/moviebrowser?schema=public"

# Shadow database for Prisma migrations (created automatically by init scripts)
SHADOW_DATABASE_URL="postgresql://moviebrowser:localdev123@localhost:5433/moviebrowser_shadow?schema=public"

# =============================================================================
# External APIs
# =============================================================================

# TMDB API - Get from https://www.themoviedb.org/settings/api
TMDB_API_KEY=your-tmdb-api-key

# YouTube Data API v3 - For trending trailers feature
# Get from: https://console.cloud.google.com/apis/credentials
# Enable: YouTube Data API v3
YOUTUBE_API_KEY=your-youtube-api-key

# =============================================================================
# CDN & URLs
# =============================================================================

# CDN for optimized images (optional - falls back to TMDB images)
CDN_API_URL=https://api.themoviebrowser.com

# Public site URL (used for OAuth callbacks, canonical URLs, etc.)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# =============================================================================
# AI Agent (AWS Bedrock)
# =============================================================================

# AWS credentials for Bedrock access
# Get from AWS IAM console - ensure the user has bedrock:InvokeModel permission
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key

# Bedrock region for inference profiles
# Use ap-south-1 for APAC profiles, us-east-1 for US profiles
BEDROCK_REGION=ap-south-1

# Bedrock model ID - use inference profile IDs for cross-region inference
# IMPORTANT: You must enable model access in AWS Bedrock console first!
#   1. Go to AWS Console > Amazon Bedrock > Model access
#   2. Click "Manage model access" and enable the desired models
#   3. Wait for approval
#
# Options (inference profile IDs):
#   apac.amazon.nova-pro-v1:0                      (Amazon Nova Pro - APAC)
#   us.anthropic.claude-haiku-4-5-20251001-v1:0    (Claude 4.5 Haiku - US)
#   us.anthropic.claude-3-haiku-20240307-v1:0      (Claude 3 Haiku - US, fallback)
#
# See: https://docs.aws.amazon.com/bedrock/latest/userguide/inference-profiles.html
BEDROCK_MODEL_ID=apac.amazon.nova-pro-v1:0

# =============================================================================
# Data Hydration Service
# =============================================================================

# Enable the new hydration service (TMDB + MongoDB/Lambda → PostgreSQL)
# When enabled, movie/series requests use the hydration flow instead of legacy
# Default: false (uses legacy TMDB + MongoDB flow)
USE_HYDRATION_SERVICE=false

# Enable MongoDB enrichment (ratings, watch links from MongoDB)
# Set to false to completely skip MongoDB and use Lambda only
# Default: true
ENABLE_MONGODB_ENRICHMENT=true

# Enable Lambda fallback when MongoDB data is stale
# Set to false to always use MongoDB data even if stale
# Default: true
ENABLE_LAMBDA_FALLBACK=true

# Data Hydration - ON by default
# Flow: PostgreSQL (fresh?) → MongoDB (fresh?) → Lambda
# Lambda functions: puppeteer-node14, movie-ratings-scraper (hardcoded)

# Disable hydration to use legacy TMDB+MongoDB flow:
# USE_HYDRATION_SERVICE=false

# Skip MongoDB, go straight to Lambda for enriched data:
# ENABLE_MONGODB_ENRICHMENT=false

# =============================================================================
# Testing
# =============================================================================

# Test User ID - For testing AI agent user context tools
# This should be the numeric Google OAuth sub of a test user in your database
# Run: yarn test:ai --user to test with this user's watchlist/ratings/watched
TEST_USER_ID=
