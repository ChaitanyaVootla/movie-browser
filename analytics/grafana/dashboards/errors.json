          "queryType": "sql",
          "rawSql": "SELECT error_type, error_source, severity, count() AS count, max(timestamp) AS last_seen, any(error_message) AS sample_message FROM errors WHERE timestamp >= today() - INTERVAL 7 DAY GROUP BY error_type, error_source, severity ORDER BY count DESC LIMIT 20",
