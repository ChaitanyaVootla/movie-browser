<clickhouse>
    <!-- Logging -->
    <logger>
        <level>warning</level>
        <log>/var/log/clickhouse-server/clickhouse-server.log</log>
        <errorlog>/var/log/clickhouse-server/clickhouse-server.err.log</errorlog>
        <size>100M</size>
        <count>3</count>
    </logger>

    <!-- Cap ClickHouse to ~2.5GB on shared EC2 (default 0.8 = 6.4GB on 8GB box) -->
    <max_server_memory_usage>2684354560</max_server_memory_usage>

    <!-- CPU containment is enforced purely by the docker-compose `cpus: 0.9`
         cgroup cap — a hard ceiling that doesn't touch ClickHouse's own config.
         Server-level thread-pool overrides were tried here but ClickHouse 25.12
         crash-looped on one of them at startup, so this stays at defaults. -->
    <!-- (cgroup cpu cap is the backstop; see docker-compose.yml) -->

    <!-- Compression (zstd level 3 is a good balance) -->
    <compression>
        <case>
            <method>zstd</method>
            <level>3</level>
        </case>
    </compression>

    <!-- HTTP Interface settings -->
    <http_server_default_response>
        <![CDATA[<html><body>ClickHouse Analytics Server</body></html>]]>
    </http_server_default_response>

    <!-- Allow connections from anywhere (secured by Docker network) -->
    <listen_host>0.0.0.0</listen_host>
</clickhouse>
