<clickhouse>
    <!-- Logging -->
    <logger>
        <level>warning</level>
        <log>/var/log/clickhouse-server/clickhouse-server.log</log>
        <errorlog>/var/log/clickhouse-server/clickhouse-server.err.log</errorlog>
        <size>100M</size>
        <count>3</count>
    </logger>

    <!-- Cap ClickHouse to ~2.2GB on shared EC2 (default 0.8 = 6.4GB on 8GB box).
         Must sit well below the docker-compose mem_limit (3GB): ClickHouse's own
         tracker misses ~0.5GB (allocator fragmentation, thread stacks), and when
         RSS crosses the cgroup limit the kernel OOM-kills the server instead of
         queries failing gracefully. 2.2GB tracked + ~0.5GB untracked < 3GB. -->
    <max_server_memory_usage>2362232012</max_server_memory_usage>

    <!-- Disable ALL system introspection logs. June 2026: these tables (never
         TTL'd) silently grew to 22.5GB — trace_log alone 18GB vs ~130MB of actual
         analytics data — and their background merges could not fit in the memory
         cap, putting the server in a cgroup OOM-kill crash loop for 9 days (387
         kills). Nothing in the app reads system.* logs. Re-enable selectively
         (with a TTL!) only when actively debugging ClickHouse itself. -->
    <query_log remove="1"/>
    <query_thread_log remove="1"/>
    <trace_log remove="1"/>
    <metric_log remove="1"/>
    <latency_log remove="1"/>
    <query_metric_log remove="1"/>
    <asynchronous_metric_log remove="1"/>
    <part_log remove="1"/>
    <text_log remove="1"/>
    <opentelemetry_span_log remove="1"/>
    <processors_profile_log remove="1"/>
    <query_views_log remove="1"/>
    <asynchronous_insert_log remove="1"/>
    <backup_log remove="1"/>
    <blob_storage_log remove="1"/>
    <error_log remove="1"/>
    <s3queue_log remove="1"/>
    <dead_letter_queue remove="1"/>
    <background_schedule_pool_log remove="1"/>
    <zookeeper_connection_log remove="1"/>

    <!-- CPU containment. Makes ClickHouse aware of its ~1-core budget so it
         self-limits query parallelism instead of spawning a thread per core and
         fighting Next.js/Postgres. SOFT limit: large queries still run (validated
         against a 100M-row aggregation in a clickhouse:25.12 container), they just
         use fewer threads. The docker-compose `cpus: 0.9` cgroup cap is the hard
         backstop. (Background-merge pool sizes are intentionally left at defaults
         — lowering background_pool_size below ~10 violates ClickHouse's mutation
         pool invariant and crash-loops startup with code 36.) -->
    <concurrent_threads_soft_limit_num>2</concurrent_threads_soft_limit_num>

    <!-- Compression (zstd level 3 is a good balance) -->
    <compression>
        <case>
            <method>zstd</method>
            <level>3</level>
        </case>
    </compression>

    <!-- HTTP Interface settings -->
    <http_server_default_response>
        <![CDATA[<html><body>ClickHouse Analytics Server</body></html>]]>
    </http_server_default_response>

    <!-- Allow connections from anywhere (secured by Docker network) -->
    <listen_host>0.0.0.0</listen_host>
</clickhouse>
