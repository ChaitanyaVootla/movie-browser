<clickhouse>
    <!-- Logging -->
    <logger>
        <level>warning</level>
        <log>/var/log/clickhouse-server/clickhouse-server.log</log>
        <errorlog>/var/log/clickhouse-server/clickhouse-server.err.log</errorlog>
        <size>100M</size>
        <count>3</count>
    </logger>

    <!-- Cap ClickHouse to ~2.5GB on shared EC2 (default 0.8 = 6.4GB on 8GB box) -->
    <max_server_memory_usage>2684354560</max_server_memory_usage>

    <!-- CPU containment. Makes ClickHouse aware of its ~1-core budget so it
         self-limits query parallelism instead of spawning a thread per core and
         fighting Next.js/Postgres. SOFT limit: large queries still run (validated
         against a 100M-row aggregation in a clickhouse:25.12 container), they just
         use fewer threads. The docker-compose `cpus: 0.9` cgroup cap is the hard
         backstop. (Background-merge pool sizes are intentionally left at defaults
         — lowering background_pool_size below ~10 violates ClickHouse's mutation
         pool invariant and crash-loops startup with code 36.) -->
    <concurrent_threads_soft_limit_num>2</concurrent_threads_soft_limit_num>

    <!-- Compression (zstd level 3 is a good balance) -->
    <compression>
        <case>
            <method>zstd</method>
            <level>3</level>
        </case>
    </compression>

    <!-- HTTP Interface settings -->
    <http_server_default_response>
        <![CDATA[<html><body>ClickHouse Analytics Server</body></html>]]>
    </http_server_default_response>

    <!-- Allow connections from anywhere (secured by Docker network) -->
    <listen_host>0.0.0.0</listen_host>
</clickhouse>
