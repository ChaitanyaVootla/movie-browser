<clickhouse>
    <!-- Logging -->
    <logger>
        <level>warning</level>
        <log>/var/log/clickhouse-server/clickhouse-server.log</log>
        <errorlog>/var/log/clickhouse-server/clickhouse-server.err.log</errorlog>
        <size>100M</size>
        <count>3</count>
    </logger>

    <!-- Cap ClickHouse to ~2.5GB on shared EC2 (default 0.8 = 6.4GB on 8GB box) -->
    <max_server_memory_usage>2684354560</max_server_memory_usage>

    <!-- CPU containment on the shared 2-vCPU box. ClickHouse defaults assume it
         owns the machine and spawn many background-merge/query threads, which
         pushed it to ~1.5 cores and starved Next.js/Postgres (load avg ~20).
         These cap thread parallelism at the source; the docker-compose `cpus`
         ceiling is the hard backstop. Analytics is best-effort, so trading some
         ingest/merge throughput for foreground responsiveness is the right call. -->
    <concurrent_threads_soft_limit_num>2</concurrent_threads_soft_limit_num>
    <background_pool_size>3</background_pool_size>
    <background_schedule_pool_size>3</background_schedule_pool_size>
    <background_common_pool_size>3</background_common_pool_size>
    <background_merges_mutations_concurrency_ratio>1</background_merges_mutations_concurrency_ratio>
    <max_concurrent_queries>6</max_concurrent_queries>

    <!-- Compression (zstd level 3 is a good balance) -->
    <compression>
        <case>
            <method>zstd</method>
            <level>3</level>
        </case>
    </compression>

    <!-- HTTP Interface settings -->
    <http_server_default_response>
        <![CDATA[<html><body>ClickHouse Analytics Server</body></html>]]>
    </http_server_default_response>

    <!-- Allow connections from anywhere (secured by Docker network) -->
    <listen_host>0.0.0.0</listen_host>
</clickhouse>
