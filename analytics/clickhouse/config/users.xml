<clickhouse>
    <profiles>
        <default>
            <!-- Query limits — per-query cap below server total so concurrent queries share safely -->
            <max_execution_time>30</max_execution_time>
            <max_rows_to_read>100000000</max_rows_to_read>
            <max_memory_usage>750000000</max_memory_usage>
            
            <!-- Asynchronous insert settings for better batch performance -->
            <async_insert>1</async_insert>
            <wait_for_async_insert>1</wait_for_async_insert>
            <async_insert_max_data_size>10000000</async_insert_max_data_size>
            <async_insert_busy_timeout_ms>1000</async_insert_busy_timeout_ms>
        </default>
    </profiles>
</clickhouse>


