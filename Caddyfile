# GA cutover (2026-06-10): the apex + www serve the Next.js app. Caddy
# auto-issues Let's Encrypt certs per site.
#
# NOTE: this file is bind-mounted into the caddy container — a `caddy reload`
# can read a STALE inode after deploy replaces the file (see
# .claude/rules/infrastructure.md). Apply changes with:
#   docker compose up -d --force-recreate caddy
#
# Jun 11 2026 — CDN rollout: CloudFront fronts the apex; this box becomes the
# origin (reached at origin.themoviebrowser.com, behind the CDN). The edge
# absorbs the anonymous-HTML + bot herd that used to cold-start-OOM the 2-vCPU
# box (see memory: prod-isr-disk-incident-jun10 / cdn-plan-jun11). The three
# CDN-pairing changes in the apex block below — (a) stale-if-error, (b) origin
# lockdown gate, (c) relaxed bot shed — ship via a NORMAL deploy AFTER the CDN
# is live. They are safe to commit now: the origin gate is no-op until
# ORIGIN_VERIFY_SECRET is set, and the relaxed bot shed only widens what we
# serve (the edge cache makes serving indexers cheap).

themoviebrowser.com, origin.themoviebrowser.com {
	header Strict-Transport-Security "max-age=31536000; includeSubDomains"
	encode zstd gzip

	# (b) ORIGIN LOCKDOWN GATE (CDN pairing, Jun 11 2026)
	# CloudFront injects `X-Origin-Verify: <secret>` on every origin request.
	# Reject anything that doesn't carry the matching secret so bots can't
	# bypass the CDN by hitting origin.themoviebrowser.com / the EIP directly
	# and re-OOM the box. The gate is CONDITIONAL on ORIGIN_VERIFY_SECRET being
	# set: while it's empty (pre-cutover, warmup, direct-access during rollout)
	# the matcher's expectation is itself empty so nothing is gated. Set the
	# secret in the EC2 .env (and the matching CloudFront origin custom header)
	# only at cutover.
	# Defense-in-depth: ALSO restrict the EC2 security group ingress to the
	# CloudFront managed prefix list (com.amazonaws.global.cloudfront.origin-facing)
	# so a leaked/guessed secret still can't reach the box from arbitrary IPs.
	@badorigin expression `"{$ORIGIN_VERIFY_SECRET:}" != "" && {http.request.header.X-Origin-Verify} != "{$ORIGIN_VERIFY_SECRET:}"`
	respond @badorigin 403 {
		close
	}

	# (c) EDGE BOT-SHED — TWO TIERS (CDN pairing, Jun 11 2026; AI reversal Jul 2 2026)
	# Before the CDN we shed ALL heavy crawlers (incl. AI indexers) here at
	# Caddy because the cold origin couldn't absorb them. After CloudFront was
	# added we tried SERVING AI crawlers (edge-cached = ~zero origin cost). That
	# was WRONG: ClickHouse showed ClaudeBot (~1.4M views/wk) + GPTBot (~0.5M/wk)
	# crawl ~1.5M UNIQUE long-tail URLs = edge cache MISSES that hit Origin Shield
	# + origin renders + puppeteer scrapes = ~98% of bot load and most of the AWS
	# bill, for ZERO search-index value. So AI training/bulk crawlers are back in
	# the shed tier (robots.txt disallows them too — both honor it; the real
	# CloudFront/Origin-Shield savings come from that voluntary back-off).
	#
	#   TIER 1 — SHED (429): pure scrapers / SEO-audit / generic HTTP clients +
	#     AI training/bulk crawlers (ClaudeBot/GPTBot/CCBot/PerplexityBot/
	#     Amazonbot/meta-externalagent). No user/index value.
	#   TIER 2 — SERVE (NOT matched here): real search indexers (Googlebot,
	#     Bingbot, Applebot) + OpenAI's user-facing fetchers (OAI-SearchBot,
	#     ChatGPT-User — low volume, real intent). robots.txt mirrors this split.
	#
	# NOTE: this origin shed only sees cache MISSES (see .claude/rules/cdn.md);
	# forged-Chrome scrapers are also caught by src/proxy.ts (missing client
	# hints), which additionally 429s the AI bot-types by name.
	@heavybots header_regexp User-Agent (?i)(bytespider|bytedance|semrushbot|ahrefsbot|dataforseo|mj12bot|dotbot|blexbot|petalbot|scrapy|python-requests|go-http-client|node-fetch|axios|wget|libwww|httpclient|headless|claudebot|gptbot|ccbot|perplexitybot|amazonbot|meta-externalagent)
	# no-store: since CloudFront forwards the real UA (Jul 28 2026) this shed
	# fires on CDN cache-misses too — a cacheable 429 would poison the URL for
	# real users (UA is not in the edge cache key).
	header @heavybots Cache-Control "private, no-store"
	respond @heavybots 429 {
		close
	}

	# TIER 1b — DATACENTER FLEET SHED (Jul 28 2026). A JS-EXECUTING browser-farm
	# crawler on Alibaba Cloud (SG 43.119.x + US 47.82.x) and Huawei Cloud SG
	# (124.243.x) crawled the long-tail catalog at ~35k renders/hr wearing a
	# genuine Chrome/145 UA WITH valid client hints — undetectable by any UA
	# heuristic. `src/proxy.ts` sheds their PAGE requests by the same IP ranges,
	# but its matcher excludes `/api/*`, and because these are real browsers the
	# JS still fired /api/auth/session + /api/geo + /api/analytics/ingest (that
	# last one POLLUTES analytics with fleet data). Caddy sees every path, so the
	# shed belongs here too. Matches the CloudFront-forwarded viewer address
	# (available since the allViewer origin-request policy, same day) and never
	# an authenticated request — a real human on a cloud VPN can still sign in.
	# These are cloud-provider allocations only; no residential users live here.
	# Jul 29: the fleet rotated to Vultr/DigitalOcean/etc across ~14k IPs, so the
	# stable signal is the hosting ASN (CloudFront-Viewer-ASN, whitelisted in the
	# origin-request policy). Keep the CIDR arm as a fallback when the ASN header
	# is absent. ASN list mirrors BLOCKED_HOSTING_ASNS in src/proxy.ts — update
	# both together. NOT listed: AWS/Google/Azure/Cloudflare (real crawlers and
	# link-unfurl bots live there).
	@dcfleet {
		header_regexp CloudFront-Viewer-ASN ^(20473|14061|45102|37963|45103|136907|55990|51167|24940|16276|63949|132203|45090|9009|49981)$
		not header_regexp Cookie (authjs\.session-token|__Secure-authjs\.session-token)
	}
	header @dcfleet Cache-Control "private, no-store"
	respond @dcfleet 429 {
		close
	}

	@dcfleetcidr {
		header_regexp CloudFront-Viewer-Address ^(43\.119\.|47\.82\.|124\.243\.)
		not header_regexp Cookie (authjs\.session-token|__Secure-authjs\.session-token)
	}
	header @dcfleetcidr Cache-Control "private, no-store"
	respond @dcfleetcidr 429 {
		close
	}

	reverse_proxy localhost:3002 {
		header_up X-Real-IP {remote_host}
		header_up X-Forwarded-For {remote_host}
		header_up X-Forwarded-Proto {scheme}

		# (a) stale-if-error (CDN pairing, Jun 11 2026)
		# Next emits `Cache-Control: s-maxage=<ttl>, stale-while-revalidate` on
		# cacheable (anonymous) HTML, but NOT `stale-if-error`. Append it so the
		# CDN can serve the last-good page when this origin 5xxs or freezes
		# (the whole point of the CDN for this box). Scope STRICTLY to document
		# responses — the `@html` matcher requires BOTH status 200 AND
		# `Content-Type: text/html*`, so static assets (already `immutable`)
		# and JSON/RSC payloads are untouched (verified locally).
		#
		# WHY a handle_response block (not `header_down +Cache-Control`):
		#   - `header_down`/inline `header @matcher` matchers match the REQUEST,
		#     not the upstream response, so they can't see Content-Type.
		#   - A response matcher MUST live in `handle_response`.
		#   - `handle_response` hands control to its inner route, so it must end
		#     with `copy_response` or the upstream BODY is dropped (verified:
		#     without it the page renders empty — this is the load-bearing line).
		#
		# CAVEAT: `+Cache-Control` adds a SECOND `Cache-Control` field line
		# rather than splicing the token into Next's existing one (verified: the
		# response carries both `s-maxage=...,stale-while-revalidate` AND
		# `stale-if-error=86400`). Per RFC 7230 §3.2.2 multiple same-name fields
		# are equivalent to one comma-joined value, and CloudFront/Cloudflare
		# both honor `stale-if-error` parsed across all Cache-Control fields —
		# so Next's s-maxage/SWR are preserved and NOT clobbered. If a future
		# CDN rejects split fields, replace the inner block with logic that
		# reads `{http.reverse_proxy.upstream.header.Cache-Control}` and
		# re-emits a single merged field.
		@html {
			status 200
			header Content-Type *text/html*
		}
		handle_response @html {
			header +Cache-Control "stale-if-error=86400"
			copy_response
		}
	}
}

# Post-GA: the beta host is the same app — 301 to the apex so search engines
# never index a duplicate site (it served identical 200s until 2026-06-10).
beta.themoviebrowser.com {
	redir https://themoviebrowser.com{uri} permanent
}

www.themoviebrowser.com {
	redir https://themoviebrowser.com{uri} permanent
}
