# GA cutover (2026-06-10): the apex + www now serve the Next.js app alongside
# beta. Caddy auto-issues Let's Encrypt certs per site; the apex/www certs can
# only be obtained once DNS points here, so expect ACME retries in the logs
# between the Caddy reload and the Route 53 flip — harmless.

themoviebrowser.com, beta.themoviebrowser.com {
	reverse_proxy localhost:3002 {
		header_up X-Real-IP {remote_host}
		header_up X-Forwarded-For {remote_host}
		header_up X-Forwarded-Proto {scheme}
	}
}

www.themoviebrowser.com {
	redir https://themoviebrowser.com{uri} permanent
}
